# Copy to .env for local development only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
POSTGRES_PASSWORD=postgres

# Application environment must be explicit.
APP_ENV=development
DEMO_MODE=false
SEED_ON_START=false
RATE_LIMITING_MODE=local

# Canonical browser origin. Use HTTPS in production.
APP_ORIGIN=http://localhost:3000

# Required in production; generate at least 24 random characters.
CRON_SECRET=

# Used only by scripts/provision-admin.ts.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Semantic RAG / grounded AI. Keep disabled locally unless an external provider is configured.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_CHAT_MODEL=gemini-2.5-flash
# Use OPENAI_API_KEY and AI_PROVIDER=openai for OpenAI instead.
