# Copy to .env for local development only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
POSTGRES_PASSWORD=postgres

# Application environment must be explicit.
APP_ENV=development
DEMO_MODE=true
SEED_ON_START=true

# Canonical browser origin. Use HTTPS in production.
APP_ORIGIN=http://localhost:3000

# Required for a production deployment; generate a unique random value.
CRON_SECRET=

# Used only by scripts/provision-admin.ts.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Option B uses deterministic rules and does not require an LLM API key.
