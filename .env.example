# Local development only. Copy to .env; never commit the resulting file.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
POSTGRES_PASSWORD=postgres
# Explicitly development-only. Set both values below for non-demo deployment.
APP_ENV=development
DEMO_MODE=true
SEED_ON_START=true
# Optional scheduled monitor secret. Generate a long random value yourself.
CRON_SECRET=
# Used only by scripts/provision-admin.ts; leave blank for the demo.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Option B has no external LLM adapter or API key requirement.
